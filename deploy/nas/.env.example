BIKEGOGOGO_HTTP_PORT=8080
BIKEGOGOGO_PRIVACY_PORT=8081
BIKEGOGOGO_ADMIN_PORT=8082
LIVEKIT_URL=wss://bikegogo-qy7s1sfz.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
ALLOWED_ORIGINS=
APPLE_BUNDLE_ID=com.sssnto.BikeGoGo
APPLE_SIGN_IN_KEY_ID=your_sign_in_with_apple_key_id
APPLE_SIGN_IN_TEAM_ID=FR9RTRV9BC
APPLE_SIGN_IN_CLIENT_ID=com.sssnto.BikeGoGo
SESSION_TTL_DAYS=30
# Nginx Proxy Manager 是后端前的唯一代理时填写 1。
TRUST_PROXY_HOPS=1
# 生成不可逆运营用户标识的密钥。生成方式：openssl rand -hex 32
ANALYTICS_HMAC_SECRET=replace_with_64_hex_characters
APNS_KEY_ID=CM2W9J6CX3
APNS_TEAM_ID=FR9RTRV9BC
APNS_TOPIC=com.sssnto.BikeGoGo
APNS_ENVIRONMENT=sandbox
APNS_PRODUCTION_KEY_ID=

# 生成方式：openssl rand -hex 32
POSTGRES_DB=bikegogogo
POSTGRES_USER=bikegogogo
POSTGRES_PASSWORD=replace_with_64_hex_characters

# 运营后台。先在本机 admin 目录运行：npm install && npm run bootstrap -- admin '<16位以上强密码>'
# 将输出复制到这里；包含 $ 的密码哈希在 .env 中必须使用单引号包裹。
# 首次成功创建管理员后，可以清空下面三项并重新创建 admin 容器。
ADMIN_ENCRYPTION_SECRET=replace_with_another_64_hex_characters
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD_HASH='$argon2id$replace_with_bootstrap_output'
ADMIN_INITIAL_TOTP_SECRET=replace_with_bootstrap_output
